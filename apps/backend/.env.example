# Pixel IT Center portal API. Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) -----------------------------------------------------
# Local without Postgres installed: `npm run db:local` starts an embedded one on 55433.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres?sslmode=disable
# Optional pool size. Use 1 with the embedded local database.
DATABASE_POOL_MAX=1

# --- Auth ------------------------------------------------------------------------
# HS256 secret for access tokens. At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Optional: required `iss` / `aud` claims.
JWT_ISSUER=
JWT_AUDIENCE=
# DEV ONLY: POST /api/dev/token issues a token for any email, so the demo
# portal can sign in. The server refuses to start with this on in production.
DEV_AUTH_ENABLED=false

# --- Encryption of passport number, SSN last four and date of birth ---------------
# 32 random bytes, base64: openssl rand -base64 32
# Losing this key means losing those fields. Keep it in a secrets manager.
PII_ENCRYPTION_KEY=
# Label stored with every encrypted value, for key rotation later.
PII_ENCRYPTION_KEY_ID=k1

# --- Document storage ---------------------------------------------------------------
# Private folder outside any web root. Created if missing.
STORAGE_DIR=./storage/uploads
# HMAC secret for short-lived file links. At least 32 characters.
FILE_URL_SECRET=
# How long a file link works, in seconds (30 to 3600).
FILE_URL_TTL_SECONDS=300
# Per-file upload limit in MB.
MAX_UPLOAD_MB=5

# --- HTTP -----------------------------------------------------------------------------
# Comma-separated origins allowed to call the API (the portal).
CORS_ORIGINS=http://localhost:3000
# true when behind a proxy / load balancer (Railway, Vercel, nginx), so rate
# limits see the client's IP and not the proxy's.
TRUST_PROXY=false
