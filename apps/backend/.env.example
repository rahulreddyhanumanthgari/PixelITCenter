# Pixel IT Center portal API. Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# --- Database (PostgreSQL) -----------------------------------------------------
# Local without Postgres installed: `npm run db:local` starts an embedded one on 55433.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55433/postgres?sslmode=disable
# Optional pool size. Use 1 with the embedded local database.
DATABASE_POOL_MAX=1

# --- Auth ------------------------------------------------------------------------
# HS256 secret for access tokens. At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Optional: required `iss` / `aud` claims.
JWT_ISSUER=
JWT_AUDIENCE=
# DEV ONLY: POST /api/dev/token issues a token for any email, so the demo
# portal can sign in. The server refuses to start with this on in production.
DEV_AUTH_ENABLED=false

# --- Encryption of passport number, SSN last four and date of birth ---------------
# 32 random bytes, base64: openssl rand -base64 32
# Losing this key means losing those fields. Keep it in a secrets manager.
PII_ENCRYPTION_KEY=
# Label stored with every encrypted value, for key rotation later.
PII_ENCRYPTION_KEY_ID=k1

# --- Document storage ---------------------------------------------------------------
# Private folder outside any web root. Created if missing.
STORAGE_DIR=./storage/uploads
# HMAC secret for short-lived file links. At least 32 characters.
FILE_URL_SECRET=
# How long a file link works, in seconds (30 to 3600).
FILE_URL_TTL_SECONDS=300
# Per-file upload limit in MB.
MAX_UPLOAD_MB=5

# --- HTTP -----------------------------------------------------------------------------
# Comma-separated origins allowed to call the API (the portal).
CORS_ORIGINS=http://localhost:3000
# true when behind a proxy / load balancer (Railway, Vercel, nginx), so rate
# limits see the client's IP and not the proxy's.
TRUST_PROXY=false

# --- Client section: email (invoices, timesheet reminders) ----------------------------
# log    = nothing is sent (default; local work)
# outbox = each email is written as a .eml file to MAIL_OUTBOX_DIR, to open and check
# smtp   = any SMTP server (Amazon SES, Google Workspace SMTP relay, Mailgun ...)
# gmail  = a Gmail / Google Workspace mailbox over OAuth2 (refresh token)
MAIL_PROVIDER=log
MAIL_FROM=Pixel IT Center Accounts <accounts@pixelitcenter.com>
MAIL_OUTBOX_DIR=./storage/outbox
# Tries per email, and the first wait between tries in ms (doubles each time).
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=2000
# MAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# MAIL_PROVIDER=gmail (Google Cloud OAuth client + a refresh token for GMAIL_USER)
GMAIL_USER=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Client section: scheduled jobs (node-cron, inside this process) -------------------
# Turn on in ONE running instance. Runs are also claimed in the JobRun table, so a
# second instance or a restart never sends twice.
JOBS_ENABLED=false
JOBS_TIMEZONE=America/New_York
# 1st of the month, 09:00: email unsent invoices + approved timesheet PDFs.
MONTHLY_INVOICE_CRON=0 9 1 * *
# Daily 09:00, but only in the last N days of the month: remind consultants with no timesheet.
TIMESHEET_REMINDER_CRON=0 9 * * *
REMINDER_DAYS_BEFORE_MONTH_END=3

# --- Client section: on every invoice and email -------------------------------------
COMPANY_NAME=Pixel IT Center
COMPANY_ADDRESS=189 Tarleton Dr, Fuquay Varina, NC 27526
COMPANY_PHONE=+1 (336) 944-6562
COMPANY_EMAIL=accounts@pixelitcenter.com
# Optional bank / remittance line printed on invoices.
COMPANY_REMIT_TO=
# Links in emails to consultants.
PORTAL_URL=http://localhost:3000
