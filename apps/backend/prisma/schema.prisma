// Portal API data.
//   - Placement Details (skill matrix) for the student Profile page. Columns
//     ending in `Enc` hold AES-256-GCM ciphertext (see src/lib/crypto.ts),
//     never plain text.
//   - Client section (admin only, bottom of this file): clients and vendors,
//     placements, timesheets, invoices, payments, email and audit logs.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ProfileStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_UPDATE
  APPROVED
}

enum DocumentType {
  RESUME
  ID
  VISA
}

model StudentProfile {
  id     String        @id @default(uuid()) @db.Uuid
  /// The student's user id: the `sub` of their auth token.
  userId String        @unique
  status ProfileStatus @default(DRAFT)

  // Personal & professional
  currentLocation         String?
  relocation              Boolean?
  relocationNote          String?
  visaStatus              String?
  contactNumber           String?
  email                   String?
  skypeId                 String?
  linkedinUrl             String?
  usExperienceYears       Float?
  relevantExperienceYears Float?
  passportNumberEnc       String?
  ssnLast4Enc             String?
  dateOfBirthEnc          String?
  usEntryVisaType         String?
  usEntryYear             Int?

  // Education
  bachelorsDegree     String?
  bachelorsUniversity String?
  bachelorsYear       Int?
  mastersDegree       String?
  mastersUniversity   String?
  mastersYear         Int?

  // Interview logistics
  availability               String?
  bestTimeForCalls           String?
  preferredInterviewLocation String?

  submittedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  references    Reference[]
  documents     ProfileDocument[]
  statusHistory ProfileStatusHistory[]
  accessLogs    PiiAccessLog[]
}

/// Two per profile, `position` 1 and 2.
model Reference {
  id        String  @id @default(uuid()) @db.Uuid
  profileId String  @db.Uuid
  position  Int
  name      String?
  role      String?
  location  String?
  email     String?
  phone     String?

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, position])
}

/// One current file per type; uploading again replaces it.
model ProfileDocument {
  id           String       @id @default(uuid()) @db.Uuid
  profileId    String       @db.Uuid
  type         DocumentType
  /// Display only. The file on disk is named by `storageKey`.
  originalName String
  /// Random name in private storage, never derived from user input.
  storageKey   String       @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  /// SKIPPED until a virus scanner is wired in (src/lib/virusScan.ts).
  scanStatus   String       @default("SKIPPED")
  uploadedAt   DateTime     @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, type])
}

model ProfileStatusHistory {
  id          String         @id @default(uuid()) @db.Uuid
  profileId   String         @db.Uuid
  fromStatus  ProfileStatus?
  toStatus    ProfileStatus
  comment     String?
  actorUserId String
  actorRole   String
  createdAt   DateTime       @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
}

/// Every time a recruiter/admin sees decrypted PII or opens a student's documents.
model PiiAccessLog {
  id          String   @id @default(uuid()) @db.Uuid
  profileId   String   @db.Uuid
  actorUserId String
  actorRole   String
  /// What was revealed, e.g. ["passportNumber", "document:VISA"].
  fields      String[]
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  profile StudentProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([actorUserId, createdAt])
}

// =====================================================================================
// Client section (internal, admin only). Clients and vendors never sign in to the
// portal; PixelIT staff track placements, timesheets, invoices and payments here.
// Money is Decimal (never float). Months are "YYYY-MM" strings.
// =====================================================================================

enum ClientType {
  CLIENT
  VENDOR
}

/// An end client, or a vendor between PixelIT and the end client. No login, no credentials.
model Client {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  type             ClientType @default(CLIENT)
  /// For vendors: who the consultant actually works for.
  endClientName    String?
  contactPerson    String?
  billingEmail     String
  vmsPortalName    String?
  vmsPortalUrl     String?
  /// Net N: an invoice is due N days after it is issued.
  paymentTermsDays Int        @default(30)
  notes            String?
  /// The monthly job emails this client's pending invoices to billingEmail.
  autoSendInvoices Boolean    @default(false)
  archivedAt       DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  placements Placement[]
  invoices   Invoice[]
  emails     EmailLog[]

  @@index([name])
}

/// The kind of job the consultant has at the client.
enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  CONTRACT_TO_HIRE
}

enum ExtensionStatus {
  ACTIVE
  EXTENSION_PENDING
  EXTENDED
  ENDED
}

/// A consultant (a placed student) working for a client.
model Placement {
  id               String          @id @default(uuid()) @db.Uuid
  clientId         String          @db.Uuid
  /// The consultant's user id (their token's `sub`). Null until they first sign in:
  /// the placement is then matched on consultantEmail and linked.
  consultantUserId String?
  consultantName   String
  /// Lower case.
  consultantEmail  String
  /// Overrides the client's end client when set.
  endClientName    String?
  role             String
  /// Per hour, charged to the client.
  billRate         Decimal         @db.Decimal(10, 2)
  /// Per hour, paid to the consultant. The only rate the consultant sees.
  payRate          Decimal         @db.Decimal(10, 2)
  startDate        DateTime        @db.Date
  endDate          DateTime?       @db.Date
  extensionStatus  ExtensionStatus @default(ACTIVE)
  employmentType   EmploymentType  @default(CONTRACT)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  client     Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  timesheets Timesheet[]
  invoices   Invoice[]

  @@index([consultantUserId])
  @@index([consultantEmail])
  @@index([clientId])
}

/// A private file (timesheet PDF, generated invoice). Served only through signed links.
model StoredFile {
  id           String   @id @default(uuid()) @db.Uuid
  /// TIMESHEET or INVOICE.
  kind         String
  originalName String
  /// Random name in private storage, never derived from user input.
  storageKey   String   @unique
  mimeType     String
  sizeBytes    Int
  sha256       String
  scanStatus   String   @default("SKIPPED")
  createdAt    DateTime @default(now())

  timesheet Timesheet?
  invoice   Invoice?
}

enum TimesheetStatus {
  RECEIVED
  VERIFIED
  VERIFIER_APPROVED
  ACCOUNTS_CHECKED
  INVOICE_RAISED
  SUBMITTED_TO_CLIENT
  REJECTED
}

/// One client-approved PDF per placement per month.
model Timesheet {
  id            String          @id @default(uuid()) @db.Uuid
  placementId   String          @db.Uuid
  month         String
  hours         Decimal         @db.Decimal(6, 2)
  leaveDays     Decimal         @default(0) @db.Decimal(4, 1)
  leaveNote     String?
  /// The hours accounts confirmed; the invoice bills these.
  approvedHours Decimal?        @db.Decimal(6, 2)
  status        TimesheetStatus @default(RECEIVED)
  fileId        String          @unique @db.Uuid
  submittedAt   DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  placement Placement                @relation(fields: [placementId], references: [id], onDelete: Restrict)
  file      StoredFile               @relation(fields: [fileId], references: [id], onDelete: Restrict)
  history   TimesheetStatusHistory[]
  invoice   Invoice?

  @@unique([placementId, month])
  @@index([month])
  @@index([status])
}

/// Audit trail of the timesheet workflow: who moved it, when, with what comment.
model TimesheetStatusHistory {
  id          String           @id @default(uuid()) @db.Uuid
  timesheetId String           @db.Uuid
  fromStatus  TimesheetStatus?
  toStatus    TimesheetStatus
  comment     String?
  actorUserId String
  actorRole   String
  actorEmail  String?
  createdAt   DateTime         @default(now())

  timesheet Timesheet @relation(fields: [timesheetId], references: [id], onDelete: Cascade)

  @@index([timesheetId, createdAt])
}

/// The furthest billing stage reached. The stage dates on Invoice are the detail.
enum InvoiceStatus {
  RAISED
  TIMESHEET_SUBMITTED
  SENT
  CLIENT_PAID
  CONSULTANT_PAID
}

/// Invoice numbers run per year: PIX-2026-0001.
model InvoiceCounter {
  year Int @id
  last Int
}

/// Raised from an accounts-checked timesheet. Client, rates and terms are copied
/// in at issue time, so later edits to the client or placement don't change it.
model Invoice {
  id                        String        @id @default(uuid()) @db.Uuid
  number                    String        @unique
  timesheetId               String        @unique @db.Uuid
  placementId               String        @db.Uuid
  clientId                  String        @db.Uuid
  month                     String
  consultantName            String
  clientName                String
  clientType                ClientType
  endClientName             String?
  contactPerson             String?
  billingEmail              String
  hours                     Decimal       @db.Decimal(6, 2)
  billRate                  Decimal       @db.Decimal(10, 2)
  payRate                   Decimal       @db.Decimal(10, 2)
  amount                    Decimal       @db.Decimal(12, 2)
  paymentTermsDays          Int
  issueDate                 DateTime      @db.Date
  dueDate                   DateTime      @db.Date
  status                    InvoiceStatus @default(RAISED)
  /// Null until the PDF is rendered (rendered again on demand if that failed).
  pdfFileId                 String?       @unique @db.Uuid
  timesheetSubmittedAt      DateTime?
  sentAt                    DateTime?
  clientPaymentExpectedDate DateTime?     @db.Date
  clientPaymentComment      String?
  clientPaidAt              DateTime?     @db.Date
  consultantPaidAt          DateTime?     @db.Date
  /// The last send failed after every retry. Cleared by a successful send.
  emailFailed               Boolean       @default(false)
  /// Stops two sends of the same invoice running at once.
  sendLockedUntil           DateTime?
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  timesheet Timesheet   @relation(fields: [timesheetId], references: [id], onDelete: Restrict)
  placement Placement   @relation(fields: [placementId], references: [id], onDelete: Restrict)
  client    Client      @relation(fields: [clientId], references: [id], onDelete: Restrict)
  pdfFile   StoredFile? @relation(fields: [pdfFileId], references: [id], onDelete: SetNull)
  payments  Payment[]
  emails    EmailLog[]

  @@index([month])
  @@index([status])
  @@index([clientId])
  @@index([dueDate])
}

enum PaymentKind {
  CLIENT_RECEIPT
  CONSULTANT_PAYOUT
}

/// Money in from the client, or out to the consultant.
model Payment {
  id             String      @id @default(uuid()) @db.Uuid
  invoiceId      String      @db.Uuid
  kind           PaymentKind
  amount         Decimal     @db.Decimal(12, 2)
  /// Received (client) or paid (consultant).
  date           DateTime    @db.Date
  comment        String?
  /// Set when an admin paid the consultant before the client paid.
  overrideReason String?
  actorUserId    String
  actorRole      String
  actorEmail     String?
  createdAt      DateTime    @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
}

enum EmailKind {
  INVOICE
  TIMESHEET_REMINDER
  TIMESHEET_REJECTED
}

enum EmailStatus {
  SENT
  FAILED
}

/// One row per send attempt.
model EmailLog {
  id                String      @id @default(uuid()) @db.Uuid
  kind              EmailKind
  invoiceId         String?     @db.Uuid
  clientId          String?     @db.Uuid
  /// Reminders and rejections: the consultant's user id.
  recipientUserId   String?
  to                String
  subject           String
  status            EmailStatus
  attempt           Int
  /// Short, safe reason (error name / SMTP code), never a message body.
  error             String?
  providerMessageId String?
  /// MANUAL, MONTHLY_JOB, REMINDER_JOB or WORKFLOW.
  trigger           String
  actorUserId       String
  createdAt         DateTime    @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  client  Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)

  @@index([invoiceId, createdAt])
  @@index([createdAt])
}

/// Every view and change of billing data: who, what, which record, when.
model AuditLog {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String
  actorRole   String
  actorEmail  String?
  /// e.g. "invoice.view", "payment.consultant.override".
  action      String
  entityType  String
  entityId    String?
  /// Small, non-sensitive context (status moves, filters, override reason).
  detail      Json?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

/// In-portal notifications (timesheet reminders, rejections).
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// Scheduled job runs, keyed by job and period, so a job never runs twice for the
/// same period (two server instances, or a restart).
model JobRun {
  key        String    @id
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  summary    Json?
}
